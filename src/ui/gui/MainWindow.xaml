                        <TextBlock Name="txtSidebarVersion" Text="v1.6.0 &quot;Apex&quot; • PowerShell 7.6+" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows 11 26H1 Ready" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="{StaticResource GridBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                <Grid x:Name="contentArea">
                    
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: DASHBOARD                                             -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewDashboard">
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Real-time system telemetry, health grade, and quick optimization actions" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,22"/>

                        <!-- Metrics Grid -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- OS Card -->
                            <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="System" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Name="txtOSName" Text="Windows 11" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Name="txtOSVersion" Text="Detecting..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Privacy Score Card -->
                            <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="🔒" FontSize="18" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtPrivacyGrade" Text="" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="txtPrivacyScore" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="/100" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Name="txtPrivacyLabel" Text="Privacy Score" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Bloatware Card -->
                            <Border Grid.Column="4" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🗑️" FontSize="18" Margin="0,0,0,6"/>
                                    <TextBlock Name="txtBloatwareCount" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Bloatware Detected" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM Card -->
                            <Border Grid.Column="6" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🧠" FontSize="18" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="txtRAM" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="%" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Name="txtRAMDetail" Text="System RAM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Quick Actions Grid -->
                        <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <Border Width="40" Height="40" Background="#1E3A8A" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Quick Optimize" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Apply safe recommended performance tweaks" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Button Name="btnQuickOptimize" Content="⚡ Run Now" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <Border Width="40" Height="40" Background="#282245" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock Text="🗑️" FontSize="20" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Remove Bloatware" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Uninstall unwanted Microsoft and third-party apps" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Button Name="btnRemoveBloatware" Content="Clean Now" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <Border Width="40" Height="40" Background="#064E3B" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock Text="📦" FontSize="20" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Install Apps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Select and batch-install essential software via Winget" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Button Name="btnInstallEssentials" Content="Browse Apps" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- System Status Card -->
                        <TextBlock Text="System Protection Status" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource NeonCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="4,0,16,0">
                                    <TextBlock Text="Telemetry &amp; Diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="indicatorTelemetry" Width="10" Height="10" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtTelemetryStatus" Text="Checking..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                                <StackPanel Grid.Column="2" Margin="16,0">
                                    <TextBlock Text="Windows Copilot (AI)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="indicatorCopilot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtCopilotStatus" Text="Checking..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}" Margin="0,2"/>

                                <StackPanel Grid.Column="4" Margin="16,0,4,0">
                                    <TextBlock Text="Windows Recall (Snapshots)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="indicatorRecall" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtRecallStatus" Text="Checking..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: SYSTEM TWEAKS                                         -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewSystemTweaks" Visibility="Collapsed">
                        <TextBlock Text="System Tweaks" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage privacy controls, gaming optimizations, power plans, and system QoL features" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabPanel">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="0,0,0,16"/>
                                </Style>
                            </TabControl.Resources>
                            
                            <!-- TAB 1: GENERAL -->
                            <TabItem Header="General" Style="{StaticResource TweaksTabItem}">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="System Features" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                            <CheckBox Name="chkDarkTheme" Content=" Enable Dark Theme"/>
                                            <CheckBox Name="chkActivityHistory" Content=" Disable Activity History"/>
                                            <CheckBox Name="chkBackgroundApps" Content=" Disable Background Apps"/>
                                            <CheckBox Name="chkClipboardHistory" Content=" Disable Clipboard History"/>
                                            <CheckBox Name="chkHibernate" Content=" Disable Hibernate Mode"/>
                                            <CheckBox Name="chkLocation" Content=" Disable Location Tracking"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="AI Integration &amp; Windows Update" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                            <CheckBox Name="chkCopilot" Content=" Disable Windows Copilot"/>
                                            <CheckBox Name="chkRecall" Content=" Disable Windows Recall (AI)"/>
                                            <CheckBox Name="chkWindowsUpdate" Content=" Manage Automatic Updates"/>
                                            
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16"/>
                                            
                                            <Button Name="btnApplyTweaks" Content="✓ Apply General Tweaks" Style="{StaticResource PrimaryButtonStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            
                            <!-- TAB 2: PRIVACY -->
                            <TabItem Header="Privacy" Style="{StaticResource TweaksTabItem}">
                                <StackPanel Margin="0,4,0,0">
                                    <Border Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Telemetry &amp; Search Debloating" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <CheckBox Name="chkTelemetry" Content=" Restrict Telemetry Collection to Security Level" Margin="0,4,0,2"/>
                                            <TextBlock Text="Restricts Windows diagnostic reporting to the bare minimum Security level (applied via General tweaks)."
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="28,0,0,16"/>
                                            
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,16"/>

                                            <TextBlock Text="One-Click Privacy Actions" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                            
                                            <WrapPanel>
                                                <Button Name="btnBlockTelemetry" Content="🔒 Block Telemetry Domains [Safe]" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,10"/>
                                                <Button Name="btnDebloatSearch" Content="🔍 Debloat Search (Bing / Web)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                                <Button Name="btnDisableSuggestions" Content="🧹 Disable Ads &amp; Suggestions" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                                <Button Name="btnRestoreSearchSuggestions" Content="↩️ Restore Search Defaults" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                                <Button Name="btnDisableTasks" Content="✓ Disable Telemetry Tasks [Recommended]" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                                <Button Name="btnAggressiveTasks" Content="⚠ Disable Tasks [Aggressive]" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,10"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                            
                            <!-- TAB 3: PERFORMANCE -->
                            <TabItem x:Name="tabPerformance" Header="Performance" Style="{StaticResource TweaksTabItem}">
                                <Grid x:Name="viewPerformance" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Power Plan &amp; Services" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            
                                            <RadioButton Name="radBalanced" Content=" Balanced Power Plan" GroupName="power" IsChecked="True"/>
                                            <RadioButton Name="radHighPerf" Content=" High Performance Plan" GroupName="power"/>
                                            <RadioButton Name="radUltimate" Content=" Ultimate Performance Plan" GroupName="power" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>

                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                                            <TextBlock Text="Service Optimizer Preset" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Tuning based on config/services.json" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                            <ComboBox Name="cmbServicePreset" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12">
                                                <ComboBoxItem Content="Privacy" IsSelected="True"/>
                                                <ComboBoxItem Content="Performance"/>
                                                <ComboBoxItem Content="Security"/>
                                                <ComboBoxItem Content="Minimal"/>
                                                <ComboBoxItem Content="Gaming"/>
                                            </ComboBox>
                                            <Button Name="btnApplyServices" Content="🔧 Apply Service Preset" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Gaming Optimizations" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <CheckBox Name="chkGamingNetwork" Content=" Low Latency Network (TCPNoDelay)"/>
                                            <CheckBox Name="chkGamingInput" Content=" Raw Mouse Input (Disable Accel)"/>
                                            <CheckBox Name="chkGamingMMCSS" Content=" Multimedia Priority (MMCSS)"/>
                                            <CheckBox Name="chkVisualEffects" Content=" Optimize Visual Effects &amp; Animations"/>
                                            <CheckBox Name="chkUltimatePlan" Content=" Unlock Ultimate Power Plan"/>
                                            
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16"/>
                                            
                                            <Button Name="btnApplyPerformance" Content="🚀 Apply Gaming Optimizations" Style="{StaticResource PrimaryButtonStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            
                            <!-- TAB 4: NETWORK -->
                            <TabItem Header="Network" x:Name="tabNetwork" Style="{StaticResource TweaksTabItem}">
                                <Grid x:Name="viewNetwork" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- DNS & PROTOCOL SETTINGS -->
                                    <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Secure DNS &amp; Encrypted Protocols" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Select a secure, low-latency or ad/threat blocking DNS resolver:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            
                                            <ComboBox Name="cmbDnsProvider" Width="360" HorizontalAlignment="Left" Margin="0,0,0,14">
                                                <ComboBoxItem Content="DHCP (Default / Automatic)" IsSelected="True"/>
                                                <ComboBoxItem Content="Cloudflare (1.1.1.1 - Privacy)"/>
                                                <ComboBoxItem Content="Cloudflare Malware Blocking (1.1.1.2)"/>
                                                <ComboBoxItem Content="Cloudflare Family Safe (1.1.1.3)"/>
                                                <ComboBoxItem Content="Google Public DNS (8.8.8.8)"/>
                                                <ComboBoxItem Content="Quad9 (9.9.9.9 - Threat Blocking)"/>
                                                <ComboBoxItem Content="AdGuard (Ad &amp; Tracker Blocking)"/>
                                                <ComboBoxItem Content="AdGuard Family Safe"/>
                                                <ComboBoxItem Content="OpenDNS (Cisco)"/>
                                                <ComboBoxItem Content="CleanBrowsing (Security Filter)"/>
                                                <ComboBoxItem Content="CleanBrowsing (Family Filter)"/>
                                                <ComboBoxItem Content="NextDNS"/>
                                            </ComboBox>
                                            
                                            <CheckBox Name="chkEnableDoH" Content=" Enable DNS-over-HTTPS (DoH Encrypted Queries)" IsChecked="True"/>
                                            <CheckBox Name="chkIncludeIPv6DNS" Content=" Configure Dual-Stack IPv6 DNS Servers"/>
                                            <CheckBox Name="chkDisableIPv6" Content=" Prefer IPv4 over IPv6 (RFC 3484 - Fix DNS Leaks)"/>
                                            
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,14"/>
                                            
                                            <Button Name="btnApplyDNS" Content="🌐 Apply DNS &amp; Protocol Settings" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECURITY HARDENING & ADAPTER CONTROLS -->
                                    <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Protocol Hardening &amp; Network Security" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <CheckBox Name="chkDisableSMBv1" Content=" Disable SMBv1 (WannaCry / EternalBlue Protection)"/>
                                            <CheckBox Name="chkDisableNetBIOS" Content=" Disable NetBIOS over TCP/IP (Mitigate NBT-NS Spoofing)"/>
                                            
                                            <Button Name="btnApplyNetSecurity" Content="🛡️ Apply Security Hardening" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,14" HorizontalAlignment="Left"/>
                                            
                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,14"/>

                                            <TextBlock Text="Network Stack &amp; Firewall Maintenance" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                            
                                            <WrapPanel>
                                                <Button Name="btnBlockTelemetryNet" Content="🔒 Block Telemetry (Firewall)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Name="btnRestoreFirewallNet" Content="↩️ Remove Firewall Block" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Name="btnResetNetworkQuick" Content="🔄 Reset Network Stack" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 5: SYSTEM QOL -->
                            <TabItem Header="System QoL" Style="{StaticResource TweaksTabItem}">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Boot / Storage / Updates -->
                                    <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Boot, Storage &amp; Updates" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <CheckBox Name="chkQolFastStartup" Content=" Disable Fast Startup"/>
                                            <CheckBox Name="chkQolBitlocker" Content=" Prevent Auto BitLocker (24H2+)"/>
                                            <CheckBox Name="chkQolDeliveryOpt" Content=" Disable Delivery Optimization (P2P)"/>
                                            <CheckBox Name="chkQolStorageSense" Content=" Disable Storage Sense"/>
                                            <CheckBox Name="chkQolNoAutoReboot" Content=" Prevent Auto-Reboot After Updates"/>
                                            <CheckBox Name="chkQolNoEarlyUpdates" Content=" Don't Get Preview Updates ASAP"/>
                                            <CheckBox Name="chkQolModernStandby" Content=" Disable Modern Standby Networking"/>
                                            <CheckBox Name="chkQolFindMyDevice" Content=" Disable Find My Device"/>
                                            <CheckBox Name="chkQolStickyKeys" Content=" Disable Sticky Keys Shortcut"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Shell / Explorer cleanup -->
                                    <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Shell &amp; Explorer Cleanup" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                            <CheckBox Name="chkQolWidgets" Content=" Disable Taskbar Widgets"/>
                                            <CheckBox Name="chkQolChat" Content=" Hide Chat / Meet Now Icon"/>
                                            <CheckBox Name="chkQolTransparency" Content=" Disable Transparency Effects"/>
                                            <CheckBox Name="chkQolSnapAssist" Content=" Disable Snap Assist Layouts"/>
                                            <CheckBox Name="chkQolStartAllApps" Content=" Hide Start 'All Apps' List"/>
                                            <CheckBox Name="chkQolFileExt" Content=" Show Known File Extensions"/>
                                            <CheckBox Name="chkQolHiddenFiles" Content=" Show Hidden &amp; System Files"/>
                                            <CheckBox Name="chkQolHideOneDrive" Content=" Hide OneDrive from Nav Pane"/>
                                            <CheckBox Name="chkQolContextClean" Content=" Clean Context Menu (Share / Access)"/>

                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12"/>
                                            
                                            <Button Name="btnApplyQoL" Content="🧰 Apply System QoL Tweaks" Style="{StaticResource PrimaryButtonStyle}"/>
                                            <Button Name="btnRevertQoL" Content="↩️ Revert Selected Tweaks" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: SOFTWARE INSTALL                                      -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewSoftware" Visibility="Collapsed">
                        <TextBlock Text="Software Install" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Batch install verified, curated open-source and essential tools via Winget" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        
                        <Border Style="{StaticResource NeonCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔎" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Name="txtSoftwareSearch" VerticalAlignment="Center" ToolTip="Type to filter apps by name"/>
                                    
                                    <Button Grid.Column="3" Name="btnSelectAllApps" Content="Select All" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                                    <Button Grid.Column="5" Name="btnDeselectAllApps" Content="Deselect All" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"/>
                                </Grid>
                                
                                <ItemsControl Name="icSoftwareCategories">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="14" FontWeight="Bold" 
                                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding Apps}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" Tag="{Binding PackageId}" 
                                                                          IsChecked="{Binding IsSelected}" Width="210" Margin="0,4"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Name="btnInstallSoftware" Content="📦 Install Selected Software" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: BACKUPS & RESTORE                                     -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewBackups" Visibility="Collapsed">
                        <TextBlock Text="Backup &amp; Restore" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage system restore points and configuration snapshots" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        
                        <Border Style="{StaticResource NeonCardStyle}">
                            <StackPanel>
                                <Button Name="btnCreateSnapshot" Content="💾 Create System Snapshot" Style="{StaticResource PrimaryButtonStyle}" 
                                        HorizontalAlignment="Left" Margin="0,0,0,18"/>
                                
                                <TextBlock Text="Available Snapshots" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                
                                <Border Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                    <ListBox Name="lstSnapshots" Background="Transparent" BorderThickness="0" 
                                             Foreground="{StaticResource TextPrimaryBrush}" MinHeight="140" Padding="6"/>
                                </Border>
                                
                                <Button Name="btnRestoreSnapshot" Content="⚠ Restore Selected Snapshot" Style="{StaticResource DangerButtonStyle}" 
                                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: TOOLS & UTILITIES                                     -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewTools" Visibility="Collapsed">
                        <TextBlock Text="Tools &amp; Utilities" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Advanced shell customizations, diagnostic repairs, and performance benchmarks" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- INTERFACE COLUMN -->
                            <Border Grid.Column="0" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🎨 Interface Tweaks" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                    
                                    <TextBlock Text="Taskbar Alignment" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <RadioButton Name="radTaskbarCenter" Content=" Center Aligned" GroupName="taskbar" IsChecked="True"/>
                                    <RadioButton Name="radTaskbarLeft" Content=" Left Aligned" GroupName="taskbar"/>
                                    
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                    <TextBlock Text="Context Menu Style" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <RadioButton Name="radCtxModern" Content=" Modern (Windows 11)" GroupName="ctx" IsChecked="True"/>
                                    <RadioButton Name="radCtxClassic" Content=" Classic (Windows 10)" GroupName="ctx"/>
                                    
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10"/>

                                    <CheckBox Name="chkHideGallery" Content=" Hide Gallery (Explorer)"/>
                                    <CheckBox Name="chkHideHome" Content=" Hide Home (Explorer)"/>
                                    
                                    <Button Name="btnApplyUITweaks" Content="✓ Apply UI Tweaks" Style="{StaticResource PrimaryButtonStyle}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- MAINTENANCE COLUMN -->
                            <Border Grid.Column="2" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🛠️ Maintenance &amp; Repair" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                    
                                    <Button Name="btnRestartExplorer" Content="🔁 Restart Explorer" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"/>
                                    <Button Name="btnUpdateDrivers" Content="🔄 Update Drivers" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"/>
                                    <Button Name="btnRepairSystem" Content="🛡️ System File Check (SFC)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"/>
                                    <Button Name="btnResetNetwork" Content="🌐 Reset Network Stack" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10"/>
                                    <Button Name="btnWinUpdateReset" Content="🔧 Reset Windows Update" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- ANALYSIS COLUMN -->
                            <Border Grid.Column="4" Style="{StaticResource NeonCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📊 System Analysis" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                                    
                                    <Button Name="btnRunBenchmark" Content="⏱️ Run Benchmark" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,14"/>
                                            
                                    <TextBlock Text="Executes an automated performance benchmark testing CPU throughput, Disk I/O, and Memory latency before and after optimization." 
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- VIEW: SETTINGS & ABOUT                                      -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="viewSettings" Visibility="Collapsed">
                        <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Application logs, updates, and environment configuration" FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        
                        <Border Style="{StaticResource NeonCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Diagnostics &amp; Maintenance" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Name="btnViewLogs" Content="📄 Open Log Folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                    <Button Name="btnCheckUpdates" Content="🔄 Check for Updates" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10"/>
                                </WrapPanel>
                                
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,18"/>
                                
                                <TextBlock Text="About Win-Debloat" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                
                                <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Name="imgAboutLogo" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Win-Debloat v1.6.0 &quot;Apex&quot; — Ultimate System Optimizer &amp; Toolbox" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Created by tomytate • Licensed under MIT" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                            <TextBlock Text="Engine: PowerShell 7.6+ • Windows 11 26H1 / 25H2 / 24H2 / 23H2 &amp; Windows 10 Ready" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- GLOBAL STATUS BAR                                               -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                        <TextBlock Name="txtStatus" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Name="btnShowLog" Content="📋 Show Log" Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="14,6" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
